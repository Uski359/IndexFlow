{
    "name": "indexflow",
    "version": "0.1.0",
    "private": true,
    "description": "IndexFlow monorepo for decentralized data indexing and search protocol",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "prepare": "husky install",
        "format": "prettier --write .",
        "build": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" --if-present run build",
        "lint": "pnpm --dir contracts run lint && pnpm --dir index-node run lint && pnpm --dir apps/playground run lint && pnpm --dir apps/backend run lint",
        "typecheck": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" --if-present run typecheck",
        "test": "pnpm --dir contracts run test && pnpm --dir index-node run test && pnpm --dir apps/playground run test && pnpm --dir apps/backend run test",
        "dev:index-node": "pnpm --dir index-node run dev",
        "dev:frontend": "pnpm --dir apps/playground run dev",
        "dev:contracts": "pnpm --dir contracts run dev",
        "dev:backend": "pnpm --dir apps/backend run dev",
        "build:index-node": "pnpm --dir index-node run build",
        "build:frontend": "pnpm --dir apps/playground run build",
        "build:contracts": "pnpm --dir contracts run build",
        "build:backend": "pnpm --dir apps/backend run build",
        "indexer:listener:all": "pnpm --dir apps/backend run indexer:listener:all",
        "sync:contracts": "node scripts/sync-contracts.mjs",
        "stack:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
        "demo": "docker compose up --build",
        "demo:down": "docker compose down",
        "stack:getting-started": "node scripts/getting-started.mjs"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.4",
        "prettier": "^3.2.5",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@vercel/analytics": "^1.5.0",
        "ethers": "^6.15.0",
        "express": "^5.1.0",
        "mongodb": "^7.0.0",
        "openai": "^6.7.0",
        "postgres-array": "^3.0.4"
    },
    "main": "scripts/legacy/compare.js",
    "directories": {
        "doc": "docs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Uski359/IndexFlow.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Uski359/IndexFlow/issues"
    },
    "homepage": "https://github.com/Uski359/IndexFlow#readme"
}
